---
import MainLayout from '../layouts/MainLayout.astro';

const ldJson = JSON.stringify({"@context": "https://schema.org", "@type": "CollectionPage", "name": "Project Portfolio", "url": "https://ahmad685.github.io/projects.html", "description": "Explore 16 production-focused portfolio projects spanning Laravel SaaS development, AI platform development, marketplace web applications, and custom business systems."});
---

<MainLayout
  title="Projects | Ahmad Akmal | SaaS, AI, Marketplace, and Business Platforms"
  description="Explore 16 production-focused portfolio projects spanning Laravel SaaS development, AI platform development, marketplace web applications, and custom business systems."
  canonical="https://ahmad685.github.io/projects.html"
  ogType="website"
  ogTitle="Projects | Ahmad Akmal | SaaS, AI, Marketplace, and Business Platforms"
  ogDesc="Explore 16 production-focused portfolio projects spanning Laravel SaaS development, AI platform development, marketplace web applications, and custom business systems."
  ogUrl="https://ahmad685.github.io/projects.html"
  ogImage="https://ahmad685.github.io/ahmad-akmal-developer.png"
  twitterCard="summary_large_image"
  twitterTitle="Projects | Ahmad Akmal | SaaS, AI, Marketplace, and Business Platforms"
  twitterDesc="Explore 16 production-focused portfolio projects spanning Laravel SaaS development, AI platform development, marketplace web applications, and custom business systems."
  twitterImage="https://ahmad685.github.io/ahmad-akmal-developer.png"
  bodyClass="projects-page"
  ldJson={ldJson}
  includeSwiper={false}
  includeValidate={false}
  page="projects"
  footerVariant="default"
>

  <main class="main">
    <section id="hero" class="hero section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="section-heading split-heading">
          <div>
            <span class="section-badge">All Projects</span>
            <h1 class="case-study-title">Engineering systems, platforms, and products built for real-world scale, complexity, and operational reliability.</h1>
          </div>
          <p>These case studies cover platforms, workflows, and business-critical tooling delivered under real production constraints.</p>
        </div>

        <div class="content-panel project-library-intro">
          <p class="lead-paragraph">Each project reflects system design, delivery, and execution across real product environments - not isolated feature work.</p>
          <p>20+ production systems across SaaS, AI, marketplaces, and automation - built around architecture, reliability, and long-term operational control.</p>
        </div>

        <div class="project-filter-shell" data-project-filters data-filter-target="#project-library-grid">
          <div class="project-filter-copy">
            <span class="section-kicker">Explore by system type</span>
            <p>Browse platforms by product category, workflow model, and operational context.</p>
          </div>
          <div class="project-filter-bar" role="toolbar" aria-label="Project categories">
            <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="filter-chip" data-filter="ai-platforms" aria-pressed="false">AI Platforms</button>
            <button type="button" class="filter-chip" data-filter="saas-platforms" aria-pressed="false">SaaS Platforms</button>
            <button type="button" class="filter-chip" data-filter="marketplace-platforms" aria-pressed="false">Marketplace Platforms</button>
            <button type="button" class="filter-chip" data-filter="e-commerce" aria-pressed="false">E-Commerce</button>
            <button type="button" class="filter-chip" data-filter="social-platforms" aria-pressed="false">Social Platforms</button>
            <button type="button" class="filter-chip" data-filter="travel-platforms" aria-pressed="false">Travel Platforms</button>
            <button type="button" class="filter-chip" data-filter="marketing-tools" aria-pressed="false">Marketing Tools</button>
            <button type="button" class="filter-chip" data-filter="digital-product-tools" aria-pressed="false">Digital Product Tools</button>
          </div>
        </div>
      </div>
    </section>

    <section id="portfolio" class="portfolio section pt-0">
