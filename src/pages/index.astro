---
import MainLayout from '../layouts/MainLayout.astro';

const ldJson = JSON.stringify([
  {"@context": "https://schema.org", "@type": "Person", "name": "Ahmad Akmal", "jobTitle": "Senior Full-Stack Engineer, AI Platform Developer, SaaS Architect", "url": "https://ahmad685.github.io", "image": "https://ahmad685.github.io/ahmad-akmal-developer.png", "sameAs": ["https://github.com/ahmad685", "https://www.linkedin.com/in/ahmad-akmal-746247177"]},
  {"@context": "https://schema.org", "@type": "WebSite", "name": "Ahmad Akmal Portfolio", "url": "https://ahmad685.github.io", "description": "Senior full-stack engineer portfolio focused on Laravel SaaS development, AI platform development, marketplace web applications, and custom business platforms."}
]);
---

<MainLayout
  title="Ahmad Akmal | Senior Full-Stack Engineer, AI Platform Developer &amp; SaaS Architect"
  description="Senior full-stack engineer building Laravel SaaS platforms, AI products, marketplaces, and automation systems for startups and digital businesses."
  keywords="senior full-stack engineer, Laravel SaaS development, AI platform development, marketplace web application, custom business platforms, SaaS architect, automation systems"
  canonical="https://ahmad685.github.io/"
  ogType="website"
  ogTitle="Ahmad Akmal | Senior Full-Stack Engineer, AI Platform Developer &amp; SaaS Architect"
  ogDesc="Production-focused portfolio covering SaaS platforms, AI systems, marketplaces, and custom business applications built with Laravel and modern web stacks."
  ogUrl="https://ahmad685.github.io/"
  ogImage="https://ahmad685.github.io/ahmad-akmal-developer.png"
  twitterCard="summary_large_image"
  twitterTitle="Ahmad Akmal | Senior Full-Stack Engineer, AI Platform Developer &amp; SaaS Architect"
  twitterDesc="Production-focused portfolio covering SaaS platforms, AI systems, marketplaces, and custom business applications built with Laravel and modern web stacks."
  twitterImage="https://ahmad685.github.io/ahmad-akmal-developer.png"
  bodyClass="index-page"
  ldJson={ldJson}
  includeSwiper={true}
  includeValidate={true}
  page="home"
  footerVariant="default"
>

  <main class="main">
    <section id="hero" class="hero section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center hero-grid">
          <div class="col-lg-7">
            <div class="hero-copy" data-aos="fade-right" data-aos-delay="150">
              <h1>
                Scalable SaaS Platforms <br>& Backend Systems 
                <br>Built for Production
              </h1>
              <p class="hero-lead">
                I help startups and SaaS teams turn product ideas into
                reliable software. Backend architecture, APIs, and scalable
                cloud infrastructure.
              </p>

              <div class="hero-actions">
                <a href="#contact" class="btn btn-primary">
                  Start a Project
                  <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a href="#portfolio" class="btn btn-secondary">
                  View Portfolio
                  <i class="bi bi-grid ms-2"></i>
                </a>
                <a
                  href="https://drive.google.com/uc?export=download&id=1SWSy_vjI51Z9bSdI7Nwmfm39ypcS58PU"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="subtle-link"
                >
                  Download Resume <i class="bi bi-download"></i>
                </a>
              </div>

              <div class="hero-meta">
                <div class="meta-pill">
                  <i class="bi bi-geo-alt"></i>
                  <span>Islamabad, Pakistan</span>
                </div>
                <div class="meta-pill">
                  <i class="bi bi-briefcase"></i>
                  <span>Available for freelance and contract work</span>
                </div>
              </div>

              <p class="hero-note">
                AI-assisted for faster prototyping and smarter iteration.
                Human-led for architecture, code quality, and production
                judgment.
              </p>
            </div>
          </div>

          <div class="col-lg-5">
            <div
              class="hero-visual"
              data-aos="fade-left"
              data-aos-delay="220"
            >
              <div class="portrait-panel">
                <img
                  src="/ahmad-akmal.png"
                  alt="Ahmad Akmal portrait"
                  class="img-fluid portrait-img"
                />
              </div>
              <div class="floating-card card-primary">
                <span class="eyebrow">Core Focus</span>
                <strong>Backend architecture, SaaS systems, APIs</strong>
              </div>
              <div class="floating-card card-secondary">
                <span class="eyebrow">Business Value</span>
                <strong
                  >Faster delivery, better performance, reliable scale</strong
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="credibility" class="stats section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="section-heading compact-heading stats-heading">
          <div>
            <span class="section-kicker">Trust Metrics</span>
            <h3>
              Proof points that reinforce senior delivery and platform
              reliability
            </h3>
          </div>
          <p>
            A concise credibility block for founders and product teams
            evaluating technical depth, delivery consistency, and production
            ownership.
          </p>
        </div>
        <div class="stats-grid">
          <article class="stat-card">
            <strong>5+</strong>
            <span>Years Building Production Systems</span>
          </article>
          <article class="stat-card">
            <strong>30+</strong>
            <span>Web Platforms Delivered</span>
          </article>
          <article class="stat-card">
            <strong>20+</strong>
            <span>Clients Across Startups and Growing Businesses</span>
          </article>
          <article class="stat-card">
            <strong>99.9%</strong>
            <span>Infrastructure Reliability Across Managed Deployments</span>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="about section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="section-heading split-heading">
          <div>
            <span class="section-kicker">About</span>
            <h2>Senior engineering support for ambitious digital products</h2>
          </div>
          <p>
            I work with startups, SaaS companies, and modern businesses that
            need more than code delivery. They need strong technical judgment,
            scalable system design, and an engineering partner who understands
            product priorities as well as implementation detail.
          </p>
        </div>

        <div class="row g-4 align-items-stretch about-grid">
          <div class="col-lg-7">
            <div class="content-panel">
              <p class="lead-paragraph">
                My work sits at the intersection of product development,
                backend architecture, and platform reliability. I build the
                systems behind SaaS products, internal platforms, admin
                panels, and business-critical workflows that teams depend on
                every day.
              </p>
              <p>
                From API design and database architecture to frontend
                delivery, deployment, and post-launch optimization, I focus on
                shipping software that is maintainable, measurable, and ready
                to grow with the business behind it.
              </p>
              <div class="about-points">
                <div>
                  <i class="bi bi-check2-circle"></i>
                  <span
                    >Scalable architecture decisions grounded in business
                    goals</span
                  >
                </div>
                <div>
                  <i class="bi bi-check2-circle"></i>
                  <span
                    >Clean, maintainable delivery across backend and
                    frontend</span
                  >
                </div>
                <div>
                  <i class="bi bi-check2-circle"></i>
                  <span
                    >Strong communication with founders, product teams, and
                    stakeholders</span
                  >
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <aside class="about-aside">
              <div class="spotlight-card">
                <span class="eyebrow">Best Fit</span>
                <h3>What I typically help clients build</h3>
                <ul>
                  <li>
                    SaaS products with multi-role dashboards and billing
                  </li>
                  <li>
                    Backend systems and APIs for web and mobile platforms
                  </li>
                  <li>
                    Platform upgrades, performance fixes, and architecture
                    reviews
                  </li>
                  <li>
                    Cloud-ready web apps with deployment and reliability needs
                  </li>
                </ul>
              </div>
              <div class="spotlight-card compact">
                <span class="eyebrow">Engineering Philosophy</span>
                <p>
                  Make the right technical choices early, keep the codebase
                  understandable, and build systems that stay reliable as the
                  product evolves.
                </p>
              </div>
            </aside>
          </div>
        </div>

        <div class="process-block">
          <div class="section-heading compact-heading">
            <div>
              <span class="section-kicker">My Development Process</span>
              <h3>A clear delivery workflow from planning to scale</h3>
            </div>
            <p>
              Each project is structured around technical clarity, fast
              feedback loops, and business-aware delivery.
            </p>
          </div>

          <div class="process-grid" data-process-grid>
            <article class="process-card process-active" data-process-step>
              <div class="process-rail" aria-hidden="true">
                <span class="process-node">01</span>
                <span class="process-progress"></span>
              </div>
              <h4>Discovery</h4>
              <p>
                Understanding product goals, technical constraints, user
                flows, and the business outcome the build needs to support.
              </p>
              <span class="process-meta"
                >Clear scope before delivery begins</span
              >
            </article>
            <article class="process-card" data-process-step>
              <div class="process-rail" aria-hidden="true">
                <span class="process-node">02</span>
                <span class="process-progress"></span>
              </div>
              <h4>Architecture</h4>
              <p>
                Designing the system structure, stack decisions, data model,
                and API approach for long-term maintainability.
              </p>
              <span class="process-meta"
                >Human-led technical direction and trade-offs</span
              >
            </article>
            <article class="process-card" data-process-step>
              <div class="process-rail" aria-hidden="true">
                <span class="process-node">03</span>
                <span class="process-progress"></span>
              </div>
              <h4>Development</h4>
              <p>
                Building maintainable backend and frontend systems with a
                focus on quality, clarity, and delivery momentum.
              </p>
              <span class="process-meta"
                >Fast iteration with reliable implementation</span
              >
            </article>
            <article class="process-card" data-process-step>
              <div class="process-rail" aria-hidden="true">
                <span class="process-node">04</span>
                <span class="process-progress"></span>
              </div>
              <h4>Optimization</h4>
              <p>
                Improving performance, reliability, data handling, and
                deployment readiness before and after launch.
              </p>
              <span class="process-meta"
                >Performance, reliability, and release readiness</span
              >
            </article>
            <article class="process-card" data-process-step>
              <div class="process-rail" aria-hidden="true">
                <span class="process-node">05</span>
                <span class="process-progress"></span>
              </div>
              <h4>Launch &amp; Support</h4>
              <p>
                Shipping with confidence, monitoring outcomes, and supporting
                the next phase of product improvement.
              </p>
              <span class="process-meta"
                >Support beyond initial delivery</span
              >
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="expertise" class="expertise section section-deep">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="section-heading">
