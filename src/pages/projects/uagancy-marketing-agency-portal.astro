  ogType="website"
  ogTitle="UAgancy Agency Operations Platform for Client, Campaign, and Reporting Workflows | Ahmad Akmal"
  ogDesc="Agency management platform for centralizing client workspaces, campaign tracking, reporting, and operational visibility."
  ogUrl="https://ahmad685.github.io/projects/uagancy-marketing-agency-portal.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/uagency/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="UAgancy Agency Operations Platform for Client, Campaign, and Reporting Workflows | Ahmad Akmal"
  twitterDesc="Agency management platform for centralizing client workspaces, campaign tracking, reporting, and operational visibility."
  twitterImage="https://ahmad685.github.io/assets/img/projects/uagency/feature.webp"
  bodyClass="project-page"
