---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "UAgancy Agency Operations Platform for Client, Campaign, and Reporting Workflows", "applicationCategory": "SaaS Platforms", "operatingSystem": "Web", "description": "Agency management platform for centralizing client workspaces, campaign tracking, reporting, and operational visibility.", "url": "https://ahmad685.github.io/projects/uagancy-marketing-agency-portal.html", "image": "https://ahmad685.github.io/assets/img/projects/uagency/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
