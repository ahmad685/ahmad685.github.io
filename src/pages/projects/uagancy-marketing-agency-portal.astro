                  <div class="col-md-6">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" name="email" id="email" required />
                  </div>
                  <div class="col-md-6">
                    <label for="project-type" class="form-label">Project Type</label>
                    <select class="form-select" name="project_type" id="project-type" required>
                      <option value="" selected disabled>Select project type</option>
                      <option value="saas-development">SaaS Platform Development</option>
                      <option value="ai-platform">AI Platform Development</option>
                      <option value="marketplace">Marketplace Web Application</option>
                      <option value="api-backend">API &amp; Backend Systems</option>
                      <option value="optimization">Performance Optimization</option>
                      <option value="consulting">Technical Consulting</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="budget-range" class="form-label">Budget Range</label>
