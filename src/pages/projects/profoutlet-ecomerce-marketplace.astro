            </div>
          </article>
          <article class="project-card project-card-detail">
            <div class="project-media">
              <img
                src="/assets/img/projects/profoutlet/profoutlet-ecommerce-platform-screen-3.webp"
                alt="ProfOutlet product interface screen 3"
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            </div>
