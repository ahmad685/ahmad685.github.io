---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale", "applicationCategory": "E-Commerce", "operatingSystem": "Web", "description": "Bagisto-powered Laravel commerce platform for catalog management, inventory control, checkout, and order operations with production-grade maintainability.", "url": "https://ahmad685.github.io/projects/profoutlet-ecomerce-marketplace.html", "image": "https://ahmad685.github.io/assets/img/projects/profoutlet/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
---

<MainLayout
  title="ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale | Ahmad Akmal"
  description="Bagisto-powered Laravel commerce platform for catalog management, inventory control, checkout, and order operations with production-grade maintainability."
  canonical="https://ahmad685.github.io/projects/profoutlet-ecomerce-marketplace.html"
  ogType="website"
  ogTitle="ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale | Ahmad Akmal"
  ogDesc="Bagisto-powered Laravel commerce platform for catalog management, inventory control, checkout, and order operations with production-grade maintainability."
  ogUrl="https://ahmad685.github.io/projects/profoutlet-ecomerce-marketplace.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/profoutlet/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale | Ahmad Akmal"
  twitterDesc="Bagisto-powered Laravel commerce platform for catalog management, inventory control, checkout, and order operations with production-grade maintainability."
  twitterImage="https://ahmad685.github.io/assets/img/projects/profoutlet/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
>

  <main class="main">
      <section class="hero section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <div class="row align-items-center hero-grid project-hero-grid">
            <div class="col-lg-7">
              <div class="hero-copy" data-aos="fade-right" data-aos-delay="150">
                <span class="section-badge">E-Commerce Case Study</span>
                <h1 class="case-study-title">ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale</h1>
                <p class="hero-lead">Delivered a scalable e-commerce foundation that helped merchants manage products, inventory, orders, and storefront operations without sacrificing performance.</p>
                <div class="hero-meta project-meta-row">
                  <div class="meta-pill"><i class="bi bi-person-workspace"></i><span><strong>Role:</strong> Senior Full-Stack Engineer</span></div>
                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 12 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 PM, 1 designer, 2 engineers</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel 11, Bagisto, Vue 3, Tailwind</span></div>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="hero-visual" data-aos="fade-left" data-aos-delay="220">
                <div class="project-media">
                  <img src="/assets/img/projects/profoutlet/feature.webp" alt="ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale main project preview" width="1600" height="1000" fetchpriority="high" decoding="async" />
                </div>
                <div class="floating-card card-primary">
                  <span class="eyebrow">Commerce Ops</span>
                  <strong>Catalog workflows, checkout reliability, and merchant tooling were optimized for growth-stage retail operations.</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="stats-grid project-impact-metrics">
            <article class="stat-card"><strong>20k+</strong><span>SKUs supported across structured catalog and inventory workflows</span></article><article class="stat-card"><strong>+27%</strong><span>Improvement in checkout completion after cart and UX refinements</span></article><article class="stat-card"><strong>-33%</strong><span>Time spent by staff updating products and order states manually</span></article><article class="stat-card"><strong>99.9%</strong><span>Storefront availability across promotions and catalog updates</span></article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
