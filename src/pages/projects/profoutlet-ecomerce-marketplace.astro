            <div class="project-media">
              <img src="/assets/img/projects/profoutlet/feature.webp" alt="ProfOutlet Laravel E-Commerce Marketplace for Catalog and Order Scale featured interface view" width="1600" height="1000" loading="eager" decoding="async" />
