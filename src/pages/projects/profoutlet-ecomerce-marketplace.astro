          <article class="project-card project-card-detail">
            <div class="project-media">
              <img
                src="/assets/img/projects/profoutlet/profoutlet-ecommerce-platform-screen-2.webp"
                alt="ProfOutlet product interface screen 2"
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
