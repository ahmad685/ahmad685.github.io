---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent", "applicationCategory": "Marketplace Platforms", "operatingSystem": "Web", "description": "Automotive marketplace platform for vehicle listings, advanced search, seller dashboards, and high-volume inventory browsing.", "url": "https://ahmad685.github.io/projects/caroogle-car-trading-platform.html", "image": "https://ahmad685.github.io/assets/img/projects/caroogle/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
---

<MainLayout
  title="Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent | Ahmad Akmal"
  description="Automotive marketplace platform for vehicle listings, advanced search, seller dashboards, and high-volume inventory browsing."
  canonical="https://ahmad685.github.io/projects/caroogle-car-trading-platform.html"
  ogType="website"
  ogTitle="Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent | Ahmad Akmal"
  ogDesc="Automotive marketplace platform for vehicle listings, advanced search, seller dashboards, and high-volume inventory browsing."
  ogUrl="https://ahmad685.github.io/projects/caroogle-car-trading-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/caroogle/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent | Ahmad Akmal"
  twitterDesc="Automotive marketplace platform for vehicle listings, advanced search, seller dashboards, and high-volume inventory browsing."
  twitterImage="https://ahmad685.github.io/assets/img/projects/caroogle/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
>

  <main class="main">
      <section class="hero section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <div class="row align-items-center hero-grid project-hero-grid">
            <div class="col-lg-7">
              <div class="hero-copy" data-aos="fade-right" data-aos-delay="150">
                <span class="section-badge">Automotive Marketplace Case Study</span>
                <h1 class="case-study-title">Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent</h1>
                <p class="hero-lead">Built a vehicle marketplace that helped buyers browse large inventories efficiently while giving sellers better tools for listing and managing vehicles.</p>
                <div class="hero-meta project-meta-row">
                  <div class="meta-pill"><i class="bi bi-person-workspace"></i><span><strong>Role:</strong> Senior Full-Stack Engineer</span></div>
                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 13 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 PM, 2 engineers</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel, Blade, Bootstrap, MySQL</span></div>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="hero-visual" data-aos="fade-left" data-aos-delay="220">
                <div class="project-media">
                  <img src="/assets/img/projects/caroogle/feature.webp" alt="Caroogle Vehicle Marketplace Platform for Listings, Search, and Buyer Intent main project preview" width="1600" height="1000" fetchpriority="high" decoding="async" />
                </div>
                <div class="floating-card card-primary">
                  <span class="eyebrow">Automotive Search</span>
                  <strong>Listing quality and filtered discovery were optimized for high-intent buyer journeys.</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="stats-grid project-impact-metrics">
            <article class="stat-card"><strong>25k+</strong><span>Live vehicle listings supported across searchable inventories</span></article><article class="stat-card"><strong>+34%</strong><span>Increase in qualified buyer inquiries after search and listing improvements</span></article><article class="stat-card"><strong><700ms</strong><span>Filtered search response time for common browse workflows</span></article><article class="stat-card"><strong>99.9%</strong><span>Marketplace availability across buyer and seller surfaces</span></article>
          </div>
        </div>
      </section>

