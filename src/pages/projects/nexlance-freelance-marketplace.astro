  ogImage="https://ahmad685.github.io/assets/img/projects/nexlance/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Nexlance Freelance Marketplace for Service Discovery, Orders, and Trust Workflows | Ahmad Akmal"
