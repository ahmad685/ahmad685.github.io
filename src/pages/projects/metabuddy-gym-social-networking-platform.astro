---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "MetaBuddy Fitness Community Platform for Events, Engagement, and Retention", "applicationCategory": "Social Platforms", "operatingSystem": "Web", "description": "Community platform for gyms and fitness brands that combines event discovery, member interaction, and engagement workflows in one scalable product.", "url": "https://ahmad685.github.io/projects/metabuddy-gym-social-networking-platform.html", "image": "https://ahmad685.github.io/assets/img/projects/metabuddy/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
---

<MainLayout
  title="MetaBuddy Fitness Community Platform for Events, Engagement, and Retention | Ahmad Akmal"
  description="Community platform for gyms and fitness brands that combines event discovery, member interaction, and engagement workflows in one scalable product."
  canonical="https://ahmad685.github.io/projects/metabuddy-gym-social-networking-platform.html"
  ogType="website"
  ogTitle="MetaBuddy Fitness Community Platform for Events, Engagement, and Retention | Ahmad Akmal"
  ogDesc="Community platform for gyms and fitness brands that combines event discovery, member interaction, and engagement workflows in one scalable product."
  ogUrl="https://ahmad685.github.io/projects/metabuddy-gym-social-networking-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/metabuddy/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="MetaBuddy Fitness Community Platform for Events, Engagement, and Retention | Ahmad Akmal"
  twitterDesc="Community platform for gyms and fitness brands that combines event discovery, member interaction, and engagement workflows in one scalable product."
  twitterImage="https://ahmad685.github.io/assets/img/projects/metabuddy/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
>

  <main class="main">
      <section class="hero section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <div class="row align-items-center hero-grid project-hero-grid">
            <div class="col-lg-7">
              <div class="hero-copy" data-aos="fade-right" data-aos-delay="150">
                <span class="section-badge">Social Platform Case Study</span>
                <h1 class="case-study-title">MetaBuddy Fitness Community Platform for Events, Engagement, and Retention</h1>
                <p class="hero-lead">Delivered a social fitness platform that helped gyms turn isolated members into active communities through events, interaction features, and operator-ready engagement workflows.</p>
                <div class="hero-meta project-meta-row">
                  <div class="meta-pill"><i class="bi bi-person-workspace"></i><span><strong>Role:</strong> Senior Full-Stack Engineer</span></div>
                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 13 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 product lead, 1 designer, 2 engineers</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel 12, React, Redis, S3</span></div>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="hero-visual" data-aos="fade-left" data-aos-delay="220">
                <div class="project-media">
                  <img src="/assets/img/projects/metabuddy/feature.webp" alt="MetaBuddy Fitness Community Platform for Events, Engagement, and Retention main project preview" width="1600" height="1000" fetchpriority="high" decoding="async" />
                </div>
                <div class="floating-card card-primary">
                  <span class="eyebrow">Community Growth</span>
                  <strong>Event discovery and social engagement became measurable retention workflows for fitness operators.</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="stats-grid project-impact-metrics">
            <article class="stat-card"><strong>+46%</strong><span>Increase in event RSVPs after improving discovery and community prompts</span></article><article class="stat-card"><strong>12k+</strong><span>Weekly social interactions handled across community surfaces</span></article><article class="stat-card"><strong>-38%</strong><span>Admin time spent coordinating events and member updates manually</span></article><article class="stat-card"><strong>99.9%</strong><span>Availability across engagement dashboards and community activity feeds</span></article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <div class="section-heading compact-heading">
