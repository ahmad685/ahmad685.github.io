---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations", "applicationCategory": "SaaS Platforms", "operatingSystem": "Web", "description": "Lead management and CRM platform for capturing leads, assigning ownership, tracking progress, and improving response speed across sales teams.", "url": "https://ahmad685.github.io/projects/lead-management-system-crm.html", "image": "https://ahmad685.github.io/assets/img/projects/leadflow-crm/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
---

<MainLayout
  title="LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations | Ahmad Akmal"
  description="Lead management and CRM platform for capturing leads, assigning ownership, tracking progress, and improving response speed across sales teams."
  canonical="https://ahmad685.github.io/projects/lead-management-system-crm.html"
  ogType="website"
  ogTitle="LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations | Ahmad Akmal"
  ogDesc="Lead management and CRM platform for capturing leads, assigning ownership, tracking progress, and improving response speed across sales teams."
  ogUrl="https://ahmad685.github.io/projects/lead-management-system-crm.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/leadflow-crm/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations | Ahmad Akmal"
  twitterDesc="Lead management and CRM platform for capturing leads, assigning ownership, tracking progress, and improving response speed across sales teams."
  twitterImage="https://ahmad685.github.io/assets/img/projects/leadflow-crm/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
>

  <main class="main">
      <section class="hero section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <div class="row align-items-center hero-grid project-hero-grid">
            <div class="col-lg-7">
              <div class="hero-copy" data-aos="fade-right" data-aos-delay="150">
                <span class="section-badge">CRM Case Study</span>
                <h1 class="case-study-title">LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations</h1>
                <p class="hero-lead">Built a CRM workflow that helped teams capture, qualify, route, and convert leads with better operational visibility and realtime updates.</p>
                <div class="hero-meta project-meta-row">
                  <div class="meta-pill"><i class="bi bi-person-workspace"></i><span><strong>Role:</strong> Senior Full-Stack Engineer</span></div>
                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 13 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 PM, 2 engineers</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel 12, Vue 3, WebSockets, Redis</span></div>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="hero-visual" data-aos="fade-left" data-aos-delay="220">
                <div class="project-media">
                  <img src="/assets/img/projects/leadflow-crm/feature.webp" alt="LeadFlow CRM for Lead Routing, Pipeline Visibility, and Sales Operations main project preview" width="1600" height="1000" fetchpriority="high" decoding="async" />
                </div>
                <div class="floating-card card-primary">
                  <span class="eyebrow">Sales Ops</span>
                  <strong>Lead visibility and assignment logic were turned into fast operator workflows instead of spreadsheet-driven follow-up.</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="stats-grid project-impact-metrics">
            <article class="stat-card"><strong>100k+</strong><span>Lead records handled across active pipelines and segmented workflows</span></article><article class="stat-card"><strong>+28%</strong><span>Improvement in lead-to-opportunity conversion after routing and visibility upgrades</span></article><article class="stat-card"><strong><1 sec</strong><span>Realtime lead update propagation for active sales teams</span></article><article class="stat-card"><strong>-45%</strong><span>Delay between lead creation and first internal response</span></article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
