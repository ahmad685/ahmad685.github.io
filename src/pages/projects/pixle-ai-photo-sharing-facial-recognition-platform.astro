const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "Pixle AI Facial Recognition Platform for Event Photo Delivery", "applicationCategory": "AI Platforms", "operatingSystem": "Web", "description": "AI-powered event photo platform that uses facial recognition and cloud processing to deliver personalized image collections at scale.", "url": "https://ahmad685.github.io/projects/pixle-ai-photo-sharing-facial-recognition-platform.html", "image": "https://ahmad685.github.io/assets/img/projects/pixle/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
