  ogType="website"
  ogTitle="Pixle AI Facial Recognition Platform for Event Photo Delivery | Ahmad Akmal"
  ogDesc="AI-powered event photo platform that uses facial recognition and cloud processing to deliver personalized image collections at scale."
  ogUrl="https://ahmad685.github.io/projects/pixle-ai-photo-sharing-facial-recognition-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/pixle/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Pixle AI Facial Recognition Platform for Event Photo Delivery | Ahmad Akmal"
  twitterDesc="AI-powered event photo platform that uses facial recognition and cloud processing to deliver personalized image collections at scale."
  twitterImage="https://ahmad685.github.io/assets/img/projects/pixle/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
