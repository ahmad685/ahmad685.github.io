                <div class="arch-node">Workspace UI</div>
                <div class="arch-arrow bi bi-arrow-down"></div>
                <div class="arch-node">Product Services</div>
                <div class="arch-arrow bi bi-arrow-down"></div>
                <div class="arch-row">
                  <div class="arch-node small">Review Workflow</div>
                  <div class="arch-node small">Operations Layer</div>
                </div>
                <div class="arch-arrow bi bi-arrow-down"></div>
                <div class="arch-node">MySQL</div>
              </div>
