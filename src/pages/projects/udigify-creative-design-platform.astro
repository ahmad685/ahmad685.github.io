  ogType="website"
  ogTitle="Udigify Creative Asset Platform for Design Operations and Content Production | Ahmad Akmal"
  ogDesc="Creative workflow platform for organizing digital assets, managing design operations, and streamlining content production across teams."
  ogUrl="https://ahmad685.github.io/projects/udigify-creative-design-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/udigify/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Udigify Creative Asset Platform for Design Operations and Content Production | Ahmad Akmal"
  twitterDesc="Creative workflow platform for organizing digital assets, managing design operations, and streamlining content production across teams."
  twitterImage="https://ahmad685.github.io/assets/img/projects/udigify/feature.webp"
  bodyClass="project-page"
