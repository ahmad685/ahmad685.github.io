                      <option value="ai-platform">AI Platform Development</option>
                      <option value="marketplace">Marketplace Web Application</option>
                      <option value="api-backend">API &amp; Backend Systems</option>
                      <option value="optimization">Performance Optimization</option>
                      <option value="consulting">Technical Consulting</option>
                    </select>
