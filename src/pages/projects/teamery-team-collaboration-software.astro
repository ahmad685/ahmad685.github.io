  ogType="website"
  ogTitle="Teamery Collaboration Platform for Task Coordination and Team Visibility | Ahmad Akmal"
  ogDesc="Collaboration software for organizing work, improving communication, and giving teams a clearer operational view of project progress."
  ogUrl="https://ahmad685.github.io/projects/teamery-team-collaboration-software.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/teamery/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Teamery Collaboration Platform for Task Coordination and Team Visibility | Ahmad Akmal"
  twitterDesc="Collaboration software for organizing work, improving communication, and giving teams a clearer operational view of project progress."
  twitterImage="https://ahmad685.github.io/assets/img/projects/teamery/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
