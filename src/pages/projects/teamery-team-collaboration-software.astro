                      <option value="3000-7000">$3k - $7k</option>
                      <option value="7000-15000">$7k - $15k</option>
                      <option value="15000-plus">$15k+</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <label for="message" class="form-label">Message</label>
                    <textarea class="form-control" name="message" rows="7" id="message" placeholder="Share your product, goals, timeline, and the technical help you need." required></textarea>
