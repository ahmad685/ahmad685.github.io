                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 12 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 PM, 2 engineers</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel, Blade, Stripe, EC2</span></div>
                </div>
