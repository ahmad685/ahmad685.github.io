                  <div class="meta-pill"><i class="bi bi-person-workspace"></i><span><strong>Role:</strong> Senior Full-Stack Engineer</span></div>
                  <div class="meta-pill"><i class="bi bi-calendar3"></i><span><strong>Timeline:</strong> 15 weeks</span></div>
                  <div class="meta-pill"><i class="bi bi-people"></i><span><strong>Team:</strong> 1 PM, 2 engineers, 1 QA</span></div>
                  <div class="meta-pill"><i class="bi bi-layers"></i><span><strong>Stack:</strong> Laravel 8, Blade, Stripe, Redis</span></div>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
