  description="Cloud HR platform for employee records, leave, attendance, and recruitment workflows inside a scalable SaaS architecture."
  canonical="https://ahmad685.github.io/projects/myhr-hr-management-system.html"
  ogType="website"
  ogTitle="MyHR Human Resource Management SaaS for Distributed Workforce Operations | Ahmad Akmal"
  ogDesc="Cloud HR platform for employee records, leave, attendance, and recruitment workflows inside a scalable SaaS architecture."
  ogUrl="https://ahmad685.github.io/projects/myhr-hr-management-system.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/myhr/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="MyHR Human Resource Management SaaS for Distributed Workforce Operations | Ahmad Akmal"
  twitterDesc="Cloud HR platform for employee records, leave, attendance, and recruitment workflows inside a scalable SaaS architecture."
  twitterImage="https://ahmad685.github.io/assets/img/projects/myhr/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
