const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "MyHR Human Resource Management SaaS for Distributed Workforce Operations", "applicationCategory": "SaaS Platforms", "operatingSystem": "Web", "description": "Cloud HR platform for employee records, leave, attendance, and recruitment workflows inside a scalable SaaS architecture.", "url": "https://ahmad685.github.io/projects/myhr-hr-management-system.html", "image": "https://ahmad685.github.io/assets/img/projects/myhr/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
