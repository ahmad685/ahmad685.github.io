  description="Merchant-focused promotions platform for publishing offers, managing discount campaigns, and tracking customer engagement."
  canonical="https://ahmad685.github.io/projects/merchantdeals-ecommerce-offers-platform.html"
  ogType="website"
  ogTitle="MerchantDeals Promotional Offers Platform for Campaign Launches and Merchant Operations | Ahmad Akmal"
  ogDesc="Merchant-focused promotions platform for publishing offers, managing discount campaigns, and tracking customer engagement."
  ogUrl="https://ahmad685.github.io/projects/merchantdeals-ecommerce-offers-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/merchantdeals/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="MerchantDeals Promotional Offers Platform for Campaign Launches and Merchant Operations | Ahmad Akmal"
  twitterDesc="Merchant-focused promotions platform for publishing offers, managing discount campaigns, and tracking customer engagement."
  twitterImage="https://ahmad685.github.io/assets/img/projects/merchantdeals/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
