const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "MerchantDeals Promotional Offers Platform for Campaign Launches and Merchant Operations", "applicationCategory": "Marketplace Platforms", "operatingSystem": "Web", "description": "Merchant-focused promotions platform for publishing offers, managing discount campaigns, and tracking customer engagement.", "url": "https://ahmad685.github.io/projects/merchantdeals-ecommerce-offers-platform.html", "image": "https://ahmad685.github.io/assets/img/projects/merchantdeals/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
