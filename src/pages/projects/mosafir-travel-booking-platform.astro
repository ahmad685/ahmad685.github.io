  ogType="website"
  ogTitle="Mosafir Travel Booking Platform for Scalable Tourism Operations | Ahmad Akmal"
  ogDesc="Laravel travel booking platform that unified destination discovery, package reservations, payment workflows, and operator dashboards for modern tourism businesses."
  ogUrl="https://ahmad685.github.io/projects/mosafir-travel-booking-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/mosafir/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Mosafir Travel Booking Platform for Scalable Tourism Operations | Ahmad Akmal"
  twitterDesc="Laravel travel booking platform that unified destination discovery, package reservations, payment workflows, and operator dashboards for modern tourism businesses."
  twitterImage="https://ahmad685.github.io/assets/img/projects/mosafir/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
