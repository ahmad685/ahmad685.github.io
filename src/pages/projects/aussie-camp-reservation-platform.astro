  ogType="website"
  ogTitle="Aussie Camp Reservation Platform for Outdoor Tourism and Campsite Operations | Ahmad Akmal"
  ogDesc="Camping reservation system for campsite discovery, availability management, and online bookings across outdoor tourism operators."
  ogUrl="https://ahmad685.github.io/projects/aussie-camp-reservation-platform.html"
  ogImage="https://ahmad685.github.io/assets/img/projects/aussie-camp/feature.webp"
  twitterCard="summary_large_image"
  twitterTitle="Aussie Camp Reservation Platform for Outdoor Tourism and Campsite Operations | Ahmad Akmal"
  twitterDesc="Camping reservation system for campsite discovery, availability management, and online bookings across outdoor tourism operators."
  twitterImage="https://ahmad685.github.io/assets/img/projects/aussie-camp/feature.webp"
  bodyClass="project-page"
  ldJson={ldJson}
  includeValidate={true}
  page="project-case"
  footerVariant="project"
