---
import MainLayout from '../../layouts/MainLayout.astro';

const ldJson = `{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "Aussie Camp Reservation Platform for Outdoor Tourism and Campsite Operations", "applicationCategory": "Travel Platforms", "operatingSystem": "Web", "description": "Camping reservation system for campsite discovery, availability management, and online bookings across outdoor tourism operators.", "url": "https://ahmad685.github.io/projects/aussie-camp-reservation-platform.html", "image": "https://ahmad685.github.io/assets/img/projects/aussie-camp/feature.webp", "author": {"@type": "Person", "name": "Ahmad Akmal"}, "creator": {"@type": "Person", "name": "Ahmad Akmal"}}`;
